# Outpour MVP configuration (copy to .env or export; see README setup section).
# Keys are read as CRIER_<PLATFORM>_API_KEY env vars first, then from
# platforms.<name>.api_key in the config file. Never commit a real key.
# For nostr-longform, use the config file: env var names cannot cleanly
# carry the hyphen, so set platforms.nostr-longform.api_key there.

# Dev.to: API key from https://dev.to/settings/extensions
CRIER_DEVTO_API_KEY=

# Medium: legacy integration token from https://medium.com/me/settings/security
# OR set the value to "manual" for copy-paste mode (no token needed).
# Note: the Medium API does not support updating or deleting posts.
CRIER_MEDIUM_API_KEY=

# Hashnode: Personal Access Token from https://hashnode.com/settings/developer
# Format: token  OR  token:publication_id (without a publication id the
# primary publication is used). Note: Hashnode moved GraphQL API access
# to paid plans in 2026; a live test is required before relying on it.
CRIER_HASHNODE_API_KEY=

# WordPress: self-hosted form https://site.com:username:app_password
# (Application Password from Users > Profile), or WordPress.com form
# site.wordpress.com:access_token.
CRIER_WORDPRESS_API_KEY=

# Ghost: https://yourblog.com:key_id:key_secret (Admin API key from
# Ghost Admin settings; the adapter signs a short-lived JWT with it).
CRIER_GHOST_API_KEY=

# Nostr short notes (kind 1): nsec1... or 64-char hex, optionally with
# a custom relay list appended: key|wss://relay.a,wss://relay.b
CRIER_NOSTR_API_KEY=

# Nostr long-form (kind 30023, Outpour): same key formats as nostr.
# Set this one in the config file, not here (see note at the top).
# platforms:
#   nostr-longform:
#     api_key: "nsec1...|wss://relay.damus.io,wss://nos.lol"
